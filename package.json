{
  "name": "folio",
  "private": true,
  "version": "0.1.0",
  "description": "A local-first desktop print preview for Markdown",
  "license": "MIT",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @folio/desktop dev",
    "dev:landing": "pnpm --filter @folio/web dev",
    "build": "pnpm --filter @folio/desktop build",
    "build:landing": "pnpm --filter @folio/web build",
    "check": "pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm build:landing",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "rust:check": "pnpm --filter @folio/desktop rust:check",
    "rust:clippy": "pnpm --filter @folio/desktop rust:clippy",
    "rust:fmt": "pnpm --filter @folio/desktop rust:fmt",
    "rust:test": "pnpm --filter @folio/desktop rust:test",
    "test": "pnpm --filter @folio/desktop test",
    "test:watch": "pnpm --filter @folio/desktop test:watch",
    "tauri": "pnpm --filter @folio/desktop tauri",
    "build:alpha": "pnpm --filter @folio/desktop build:alpha"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.0"
  }
}
